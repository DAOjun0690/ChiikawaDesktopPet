<Window x:Class="ChiikawaDesktopPet.Wpf.BongoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        Title="Bongo 打字pet">
    <Window.ContextMenu>
        <ContextMenu x:Name="BongoContextMenu" />
    </Window.ContextMenu>
    <Grid x:Name="RootContainer" HorizontalAlignment="Center" VerticalAlignment="Bottom">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Speech Bubble Container (independent of pet scale) -->
        <Grid x:Name="BubbleContainer"
              Grid.Row="0"
              HorizontalAlignment="Center"
              Visibility="Collapsed"
              Margin="10,12,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Pointer Triangle pointing up to Bongo (when bubble is placed below) -->
            <Path x:Name="BubblePointerUp"
                  Grid.Row="0"
                  Data="M 0,6 L 5,0 L 10,6 Z"
                  Fill="White"
                  Stroke="#2B2B2B"
                  StrokeThickness="1.8"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,-1.8"
                  Visibility="Collapsed"
                  Panel.ZIndex="1" />

            <!-- Bubble Body -->
            <Border x:Name="BubbleBorder"
                    Grid.Row="1"
                    Background="White"
                    BorderBrush="#2B2B2B"
                    BorderThickness="1.8"
                    CornerRadius="10"
                    Padding="12,7"
                    MaxWidth="360">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.3" Direction="270" />
                </Border.Effect>
                <ScrollViewer x:Name="BubbleScrollViewer"
                              MaxHeight="450"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="BubbleText"
                               TextWrapping="Wrap"
                               FontSize="13"
                               FontFamily="Microsoft JhengHei, Segoe UI, sans-serif"
                               FontWeight="Normal"
                               Foreground="#2B2B2B"
                               TextAlignment="Center" />
                </ScrollViewer>
            </Border>

            <!-- Pointer Triangle pointing down to Bongo (when bubble is placed above) -->
            <Path x:Name="BubblePointerDown"
                  Grid.Row="2"
                  Data="M 0,0 L 5,6 L 10,0 Z"
                  Fill="White"
                  Stroke="#2B2B2B"
                  StrokeThickness="1.8"
                  HorizontalAlignment="Center"
                  Margin="0,-1.8,0,0"
                  Visibility="Visible"
                  Panel.ZIndex="1" />
        </Grid>

        <!-- Bongo Pet Visual Layers (scaled independently from bubble) -->
        <Grid x:Name="PetVisualContainer"
              Grid.Row="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              MouseLeftButtonDown="OnMouseLeftButtonDown">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="WindowScaleTransform" ScaleX="0.5" ScaleY="0.5" />
            </Grid.LayoutTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left side Banana Tree (grows with Ctrl+C / Ctrl+V) -->
            <Grid x:Name="BananaTreeContainer"
                  Grid.Column="0"
                  Width="128"
                  Height="240"
                  VerticalAlignment="Bottom"
                  Margin="0,0,-10,0"
                  Background="Transparent"
                  MouseLeftButtonDown="OnBananaTreeMouseLeftButtonDown">
                <Image x:Name="BananaTreeBaseImage"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
                <Image x:Name="BananaFruitImage"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"
                       RenderTransformOrigin="0.64,0.46">
                    <Image.RenderTransform>
                        <RotateTransform x:Name="BananaSwayTransform" Angle="0" />
                    </Image.RenderTransform>
                </Image>
            </Grid>

            <!-- Right side Bongo Pet Layers -->
            <Grid x:Name="BongoPetLayers" Grid.Column="1">
                <!-- Overdrive / Heat background effects -->
                <Image x:Name="EffectImage"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />

                <!-- Character body & face layer (Normal, Focused, Overdrive) -->
                <Image x:Name="FaceImage"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

                <!-- Banana eating animation layer (Monkey skin) -->
                <Image x:Name="EatAnimationImage"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />

                <!-- Desk, Mousepad on Left, Keyboard on Right -->
                <Image x:Name="BodyImage"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

                <!-- Left paw layer (Mouse Hand on the left mousepad) -->
                <Image x:Name="LeftPawImage"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="LeftPawTransform" X="0" Y="0" />
                    </Image.RenderTransform>
                </Image>

                <!-- Right paw layer (Keyboard Hand on the right keyboard) -->
                <Image x:Name="RightPawImage"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="RightPawTransform" X="0" Y="0" />
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </Grid>
    </Grid>
</Window>

