<!-- src/ChiikawaDesktopPet.Wpf/CharacterWindow.xaml -->
<Window x:Class="ChiikawaDesktopPet.Wpf.CharacterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid x:Name="RootGrid" HorizontalAlignment="Center" VerticalAlignment="Bottom">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Speech Bubble Container -->
        <Grid x:Name="BubbleContainer"
              Grid.Row="0"
              HorizontalAlignment="Center"
              Visibility="Collapsed"
              Margin="10,8,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Pointer Triangle pointing up to the character (when bubble is placed below character) -->
            <Path x:Name="BubblePointerUp"
                  Grid.Row="0"
                  Data="M 0,6 L 5,0 L 10,6 Z"
                  Fill="White"
                  Stroke="#2B2B2B"
                  StrokeThickness="1.8"
                  HorizontalAlignment="Center"
                  Margin="0,0,0,-1.8"
                  Visibility="Collapsed"
                  Panel.ZIndex="1" />

            <!-- Bubble Body -->
            <Border x:Name="BubbleBorder"
                    Grid.Row="1"
                    Background="White"
                    BorderBrush="#2B2B2B"
                    BorderThickness="1.8"
                    CornerRadius="10"
                    Padding="12,7"
                    MaxWidth="320">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.3" Direction="270" />
                </Border.Effect>
                <TextBlock x:Name="BubbleText"
                           TextWrapping="Wrap"
                           FontSize="12.5"
                           FontFamily="Microsoft JhengHei, Segoe UI, sans-serif"
                           FontWeight="Bold"
                           Foreground="#2B2B2B"
                           TextAlignment="Center" />
            </Border>

            <!-- Pointer Triangle pointing down to the character (when bubble is placed above character) -->
            <Path x:Name="BubblePointerDown"
                  Grid.Row="2"
                  Data="M 0,0 L 5,6 L 10,0 Z"
                  Fill="White"
                  Stroke="#2B2B2B"
                  StrokeThickness="1.8"
                  HorizontalAlignment="Center"
                  Margin="0,-1.8,0,0"
                  Visibility="Visible"
                  Panel.ZIndex="1" />
        </Grid>

        <!-- Sprite Image -->
        <Image x:Name="SpriteImage"
               Grid.Row="1"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom" />
    </Grid>
</Window>
